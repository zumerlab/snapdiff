{
  "name": "@zumer/snapdiff",
  "version": "0.2.0",
  "description": "Client-side visual regression testing powered by snapDOM. No headless browser, no extra binaries — capture, diff and review in the page itself.",
  "type": "module",
  "main": "./dist/snapdiff.js",
  "module": "./dist/snapdiff.mjs",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/snapdiff.mjs",
      "require": "./dist/snapdiff.js",
      "default": "./dist/snapdiff.mjs"
    },
    "./auto": "./src/auto.js",
    "./diff": "./src/diff.js",
    "./store": "./src/store.js",
    "./runner": "./src/runner.js",
    "./reporter": "./src/reporter.js",
    "./file-store": "./src/file-store.js",
    "./stale": "./src/stale-check.js",
    "./static-report": "./src/static-report.js",
    "./vitest": "./vitest/index.js",
    "./vitest/suite": "./vitest/suite.js",
    "./vitest/iframe-capture": "./vitest/iframe-capture.js"
  },
  "bin": {
    "snapdiff-stale": "./bin/snapdiff-stale.js"
  },
  "files": [
    "bin/",
    "dist/",
    "src/",
    "vitest/",
    "README.md"
  ],
  "scripts": {
    "compile": "node esbuild.config.mjs",
    "lint": "eslint src vitest __tests__ bin --ext .js",
    "lint:fix": "eslint src vitest __tests__ bin --ext .js --fix",
    "test": "npm run lint:fix && npx vitest run --browser.headless --reporter=verbose",
    "test:coverage": "npx vitest run --browser.headless --coverage",
    "demo": "npx serve .",
    "bump:dry": "npx @zumerbox/bump -d",
    "bump": "npx @zumerbox/bump && npx @zumerbox/changelog",
    "build": "npm run compile && npm pack",
    "prebuild": "git add CHANGELOG.md && git commit -m \"Bumped version\" && git push --follow-tags"
  },
  "peerDependencies": {
    "@zumer/snapdom": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "@zumer/snapdom": {
      "optional": false
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@vitest/browser": "^3.1.2",
    "@vitest/coverage-v8": "^3.1.2",
    "esbuild": "^0.25.0",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "playwright": "^1.52.0",
    "vitest": "^3.1.2"
  },
  "keywords": [
    "snapdom",
    "visual-regression",
    "visual-diff",
    "screenshot-testing",
    "pixel-diff",
    "client-side-testing",
    "browser-testing",
    "no-puppeteer",
    "no-playwright",
    "snapshot-testing",
    "in-page-testing",
    "indexeddb",
    "yiq",
    "antialiasing",
    "vitest"
  ],
  "author": "Juan Martin Muda",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zumerlab/snapdiff.git"
  },
  "homepage": "https://github.com/zumerlab/snapdiff",
  "bugs": {
    "url": "https://github.com/zumerlab/snapdiff/issues"
  }
}
